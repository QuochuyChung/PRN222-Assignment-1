@model RubricDeleteViewModel
@{
    ViewData["Title"] = "Delete Rubric Criterion";
}

<h1 class="text-danger">Delete Rubric Criterion</h1>
<div class="alert alert-warning">
    <strong>Warning:</strong> Are you sure you want to delete this rubric criterion? This action cannot be undone.
</div>
<hr />

<div class="card mb-4 bg-light">
    <div class="card-body">
        <h6 class="card-subtitle mb-2 text-muted">
            <span class="badge bg-secondary">@Model.SubjectCode</span> @Model.SubjectName
        </h6>
        <p class="card-text"><strong>Question:</strong> @Model.QuestionContent</p>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Criterion name</dt>
    <dd class="col-sm-9 font-weight-bold">@Model.CriterionName</dd>

    <dt class="col-sm-3">Description / Guide</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

    <dt class="col-sm-3">Max score</dt>
    <dd class="col-sm-9"><span class="badge bg-primary fs-6">@Model.MaxScore</span></dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.RubricCriterionId" method="post">
    <input type="hidden" asp-for="RubricCriterionId" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-controller="Questions" asp-action="Details" asp-route-id="@Model.QuestionId" class="btn btn-outline-secondary">Cancel</a>
</form>
