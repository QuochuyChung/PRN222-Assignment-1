@model RubricFormViewModel
@{
    ViewData["Title"] = "Thêm tiêu chí rubric";
}

<h1>Thêm tiêu chí rubric</h1>
<hr />

<div class="card mb-4 bg-light">
    <div class="card-body">
        <h6 class="card-subtitle mb-2 text-muted">
            <span class="badge bg-secondary">@Model.SubjectCode</span> @Model.SubjectName
        </h6>
        <p class="card-text"><strong>Câu hỏi:</strong> @Model.QuestionContent</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="QuestionId" />

            <div class="mb-3">
                <label asp-for="CriterionName" class="form-label"></label>
                <input asp-for="CriterionName" class="form-control" placeholder="VD: Nắm vững khái niệm cơ bản..." />
                <span asp-validation-for="CriterionName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Mô tả tiêu chí chi tiết hoặc hướng dẫn chấm điểm..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaxScore" class="form-label"></label>
                <input asp-for="MaxScore" type="number" step="0.25" min="0.01" max="100" class="form-control" style="max-width: 200px;" />
                <span asp-validation-for="MaxScore" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu tiêu chí</button>
                <a asp-controller="Questions" asp-action="Details" asp-route-id="@Model.QuestionId" class="btn btn-outline-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
