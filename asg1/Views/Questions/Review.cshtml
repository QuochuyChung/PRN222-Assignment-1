@model asg1.Models.Entities.Question
@using asg1.Models.Enums

@{
    ViewData["Title"] = "Review Question";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-info text-dark">
                <h4 class="mb-0">Review Question Details</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Subject</dt>
                    <dd class="col-sm-9 fw-bold">@Model.Subject?.Name</dd>
                    
                    <dt class="col-sm-3 text-muted">Content</dt>
                    <dd class="col-sm-9"><div class="p-3 bg-light border rounded">@Html.Raw(Model.Content)</div></dd>

                    <dt class="col-sm-3 text-muted mt-3">Bloom Level</dt>
                    <dd class="col-sm-9 mt-3"><span class="badge bg-primary">@Model.BloomLevel</span></dd>

                    <dt class="col-sm-3 text-muted">Source</dt>
                    <dd class="col-sm-9">@Model.Source</dd>
                    
                    <dt class="col-sm-3 text-muted">Current Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary fs-6">@Model.Status</span>
                    </dd>
                </dl>
                
                <hr class="my-4" />
                
                <form asp-action="Review" class="bg-light p-4 rounded border">
                    <h5 class="mb-3 text-primary"><i class="bi bi-shield-check"></i> Lecturer Decision</h5>
                    <input type="hidden" asp-for="QuestionId" />
                    
                    <div class="form-group mb-4">
                        <label for="status" class="form-label fw-bold">Change Status To:</label>
                        <select name="status" class="form-select w-50" id="status">
                            @foreach (var val in Enum.GetValues(typeof(QuestionStatus)))
                            {
                                if ((QuestionStatus)val == Model.Status)
                                {
                                    <option value="@val" selected>@val</option>
                                }
                                else
                                {
                                    <option value="@val">@val</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Save Decision
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
