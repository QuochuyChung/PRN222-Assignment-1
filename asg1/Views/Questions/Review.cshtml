@model asg1.Models.Entities.Question
@using asg1.Models.Enums

@{
    ViewData["Title"] = "Review Question";
}

<h1>Review Question</h1>

<div>
    <h4>Review Details (Draft &rarr; Approved/Rejected)</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Subject</dt>
        <dd class="col-sm-10">@Model.Subject?.Name</dd>
        
        <dt class="col-sm-2">Content</dt>
        <dd class="col-sm-10">@Model.Content</dd>

        <dt class="col-sm-2">Bloom Level</dt>
        <dd class="col-sm-10">@Model.BloomLevel</dd>

        <dt class="col-sm-2">Source</dt>
        <dd class="col-sm-10">@Model.Source</dd>
        
        <dt class="col-sm-2">Current Status</dt>
        <dd class="col-sm-10">
            <span class="badge bg-secondary text-dark">@Model.Status</span>
        </dd>
    </dl>
</div>

<form asp-action="Review">
    <input type="hidden" asp-for="QuestionId" />
    <div class="form-group mt-3">
        <label for="status" class="control-label fw-bold">Decision (Change Status)</label>
        <select name="status" class="form-control w-25 mt-1" id="status">
            @foreach (var val in Enum.GetValues(typeof(QuestionStatus)))
            {
                if ((QuestionStatus)val == Model.Status)
                {
                    <option value="@val" selected>@val</option>
                }
                else
                {
                    <option value="@val">@val</option>
                }
            }
        </select>
    </div>
    
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Save Decision</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
