@model QuestionFormViewModel
@{
    ViewData["Title"] = "Tạo câu hỏi";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Tạo câu hỏi mới</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SubjectId" class="form-label fw-bold"></label>
                        <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-bold"></label>
                        <textarea asp-for="Content" class="form-control" rows="6" id="tinyMceContent" placeholder="Nhập nội dung câu hỏi..."></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BloomLevel" class="form-label fw-bold"></label>
                        <select asp-for="BloomLevel" asp-items="Html.GetEnumSelectList<BloomLevel>()" class="form-select"></select>
                        <span asp-validation-for="BloomLevel" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <div>
                            <button type="submit" name="nextAction" value="stay" class="btn btn-primary me-2">
                                <i class="bi bi-plus"></i> Lưu &amp; tạo thêm
                            </button>
                            <button type="submit" name="nextAction" value="list" class="btn btn-success">
                                <i class="bi bi-save"></i> Lưu &amp; về danh sách
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#tinyMceContent',
            plugins: 'lists code table',
            toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent',
            menubar: false,
            branding: false
        });
    </script>
}
