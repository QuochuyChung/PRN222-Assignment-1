@model QuestionFormViewModel
@{
    ViewData["Title"] = "Tạo câu hỏi";
}

<h1>Tạo câu hỏi mới</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" class="form-control" rows="5"
                          placeholder="Nhập nội dung câu hỏi..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubjectId" class="form-label"></label>
                <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BloomLevel" class="form-label"></label>
                <select asp-for="BloomLevel" asp-items="Html.GetEnumSelectList<BloomLevel>()" class="form-select"></select>
                <span asp-validation-for="BloomLevel" class="text-danger"></span>
            </div>

            <button type="submit" name="nextAction" value="stay" class="btn btn-primary">Lưu &amp; tạo thêm</button>
            <button type="submit" name="nextAction" value="list" class="btn btn-success">Lưu &amp; về danh sách</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
