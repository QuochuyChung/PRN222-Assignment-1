@model QuestionDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết câu hỏi";
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Chi tiết câu hỏi #@Model.QuestionId</h1>
<hr />
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết câu hỏi #@Model.QuestionId</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Môn học</dt>
                    <dd class="col-sm-9 fw-bold">@Model.SubjectCode - @Model.SubjectName</dd>

                    <dt class="col-sm-3 text-muted mt-3">Nội dung</dt>
                    <dd class="col-sm-9 mt-3"><div class="p-3 bg-light border rounded">@Html.Raw(Model.Content)</div></dd>

                    <dt class="col-sm-3 text-muted mt-3">Mức độ Bloom</dt>
                    <dd class="col-sm-9 mt-3"><span class="badge bg-primary">@Html.DisplayFor(m => m.BloomLevel)</span></dd>

                    <dt class="col-sm-3 text-muted mt-2">Nguồn</dt>
                    <dd class="col-sm-9 mt-2">@Html.DisplayFor(m => m.Source)</dd>

                    <dt class="col-sm-3 text-muted mt-2">Ngày tạo</dt>
                    <dd class="col-sm-9 mt-2">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-3 text-muted mt-2">Trạng thái</dt>
                    <dd class="col-sm-9 mt-2">
                        @if (Model.Status == asg1.DAL.Enums.QuestionStatus.Draft)
                        { <span class="badge bg-warning text-dark fs-6">Nháp</span> }
                        else if (Model.Status == asg1.DAL.Enums.QuestionStatus.Approved)
                        { <span class="badge bg-success fs-6">Đã duyệt</span> }
                        else if (Model.Status == asg1.DAL.Enums.QuestionStatus.Rejected)
                        { <span class="badge bg-danger fs-6">Từ chối</span> }
                        else
                        { <span class="badge bg-secondary fs-6">@Html.DisplayFor(m => m.Status)</span> }
                    </dd>
                </dl>

                <hr class="my-4" />
                <h5 class="text-primary mb-3"><i class="bi bi-list-check"></i> Rubric chấm điểm (@Model.RubricCriteria.Count)</h5>
                @if (!Model.RubricCriteria.Any())
                {
                    <div class="alert alert-info py-2"><i class="bi bi-info-circle"></i> Câu hỏi chưa có tiêu chí chấm điểm.</div>
                }
                else
                {
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Tiêu chí</th>
                                <th style="width: 140px;">Điểm tối đa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var criterion in Model.RubricCriteria)
                            {
                                <tr>
                                    <td>@criterion.CriterionName</td>
                                    <td>@criterion.MaxScore</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

<hr />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Rubric chấm điểm (@Model.RubricCriteria.Count tiêu chí)</h4>
    <a asp-controller="Rubrics" asp-action="Create" asp-route-questionId="@Model.QuestionId" class="btn btn-success">
        + Thêm tiêu chí rubric
    </a>
</div>

@if (!Model.RubricCriteria.Any())
{
    <div class="alert alert-info">
        Câu hỏi chưa có tiêu chí chấm điểm. Hãy bấm <strong>+ Thêm tiêu chí rubric</strong> để tạo tiêu chí chấm điểm cho câu hỏi này.
    </div>
}
else
{
    var totalScore = Model.RubricCriteria.Sum(r => r.MaxScore);
    <table class="table table-sm table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 25%;">Tiêu chí</th>
                <th>Mô tả / Hướng dẫn chấm</th>
                <th style="width: 130px;" class="text-end">Điểm tối đa</th>
                <th style="width: 140px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var criterion in Model.RubricCriteria)
            {
                <tr>
                    <td class="fw-semibold">@criterion.CriterionName</td>
                    <td>@(string.IsNullOrWhiteSpace(criterion.Description) ? "—" : criterion.Description)</td>
                    <td class="text-end fw-bold text-primary">@criterion.MaxScore</td>
                    <td class="text-center">
                        <a asp-controller="Rubrics" asp-action="Edit" asp-route-id="@criterion.RubricCriterionId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-controller="Rubrics" asp-action="Delete" asp-route-id="@criterion.RubricCriterionId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="2" class="text-end">Tổng điểm tối đa:</th>
                <th class="text-end text-success fs-6">@totalScore</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.QuestionId" class="btn btn-primary me-2">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.QuestionId" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.QuestionId" class="btn btn-primary">Sửa câu hỏi</a>
    <a asp-action="Delete" asp-route-id="@Model.QuestionId" class="btn btn-outline-danger">Xóa câu hỏi</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>
