@model QuestionDetailsViewModel
@{
    ViewData["Title"] = "Question Details";
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Question Details #@Model.QuestionId</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Content</dt>
    <dd class="col-sm-9">@Model.Content</dd>

    <dt class="col-sm-3">Subject</dt>
    <dd class="col-sm-9">@Model.SubjectCode - @Model.SubjectName</dd>

    <dt class="col-sm-3">Bloom level</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.BloomLevel)</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>

    <dt class="col-sm-3">Source</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Source)</dd>

    <dt class="col-sm-3">Created at</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-primary mb-0"><i class="bi bi-list-check"></i> Rubric chấm điểm (@Model.RubricCriteria.Count tiêu chí)</h5>
                    <a asp-controller="Rubrics" asp-action="Create" asp-route-questionId="@Model.QuestionId" class="btn btn-success btn-sm">
                        + Thêm tiêu chí rubric
                    </a>
                </div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Grading Rubric (@Model.RubricCriteria.Count criteria)</h4>
    <a asp-controller="Rubrics" asp-action="Create" asp-route-questionId="@Model.QuestionId" class="btn btn-success">
        + Add Rubric Criterion
    </a>
</div>

@if (!Model.RubricCriteria.Any())
{
    <div class="alert alert-info">
        This question has no grading criteria yet. Click <strong>+ Add Rubric Criterion</strong> to create grading criteria for this question.
    </div>
}
else
{
    var totalScore = Model.RubricCriteria.Sum(r => r.MaxScore);
    <table class="table table-sm table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 25%;">Criterion</th>
                <th>Description / Grading guide</th>
                <th style="width: 130px;" class="text-end">Max score</th>
                <th style="width: 140px;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var criterion in Model.RubricCriteria)
            {
                <tr>
                    <td class="fw-semibold">@criterion.CriterionName</td>
                    <td>@(string.IsNullOrWhiteSpace(criterion.Description) ? "—" : criterion.Description)</td>
                    <td class="text-end fw-bold text-primary">@criterion.MaxScore</td>
                    <td class="text-center">
                        <a asp-controller="Rubrics" asp-action="Edit" asp-route-id="@criterion.RubricCriterionId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Rubrics" asp-action="Delete" asp-route-id="@criterion.RubricCriterionId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="2" class="text-end">Total max score:</th>
                <th class="text-end text-success fs-6">@totalScore</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.QuestionId" class="btn btn-primary">Edit Question</a>
    <a asp-action="Delete" asp-route-id="@Model.QuestionId" class="btn btn-outline-danger">Delete Question</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
