@model asg1.Models.Entities.Question

@{
    ViewData["Title"] = "Delete Question";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h4>
            </div>
            <div class="card-body">
                <h5 class="text-danger mb-4">Are you sure you want to delete this question? This action cannot be undone.</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Subject</dt>
                    <dd class="col-sm-9 fw-bold">@Model.Subject?.Name</dd>
                    
                    <dt class="col-sm-3 text-muted">Content</dt>
                    <dd class="col-sm-9"><div class="p-3 bg-light border rounded">@Html.Raw(Model.Content)</div></dd>
                    
                    <dt class="col-sm-3 text-muted mt-3">Status</dt>
                    <dd class="col-sm-9 mt-3">
                        <span class="badge bg-secondary fs-6">@Model.Status</span>
                    </dd>
                </dl>
                
                <hr class="my-4" />
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="QuestionId" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Permanently Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
