@model QuestionDetailsViewModel
@{
    ViewData["Title"] = "Delete Question";
}

<h1>Confirm Delete</h1>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete this question? This action cannot be undone.
</div>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.QuestionId</dd>

    <dt class="col-sm-3">Content</dt>
    <dd class="col-sm-9">@Model.Content</dd>

    <dt class="col-sm-3">Subject</dt>
    <dd class="col-sm-9">@Model.SubjectCode - @Model.SubjectName</dd>

    <dt class="col-sm-3">Bloom level</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.BloomLevel)</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.QuestionId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
