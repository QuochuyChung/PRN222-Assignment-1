@model QuestionIndexViewModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0 text-primary"><i class="bi bi-question-circle"></i> Ngân hàng câu hỏi</h4>
        <div class="d-flex align-items-center gap-3">
            <form id="filterForm" asp-action="Index" method="get" class="d-flex gap-2 mb-0">
                <input asp-for="Keyword" id="searchInput" class="form-control" placeholder="Tìm theo nội dung..." />
                <select asp-for="SubjectId" id="subjectSelect" asp-items="Model.SubjectOptions" class="form-select"></select>
                <select asp-for="Status" id="statusSelect" asp-items="Model.StatusOptions" class="form-select"></select>
            </form>
            <a asp-action="Create" class="btn btn-primary text-nowrap"><i class="bi bi-plus-circle"></i> Tạo mới</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th class="w-50">Nội dung</th>
                        <th class="text-nowrap">Môn học</th>
                        <th class="text-nowrap">Mức độ Bloom</th>
                        <th class="text-nowrap">Trạng thái</th>
                        <th class="text-nowrap">Ngày tạo</th>
                        <th class="text-nowrap">Rubric</th>
                        <th class="text-center text-nowrap">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy câu hỏi nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.QuestionId</td>
                            <td>
                                <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;">
                                    @Html.Raw(item.Content)
                                </div>
                            </td>
                            <td><span class="badge bg-secondary">@item.SubjectCode - @item.SubjectName</span></td>
                            <td><span class="badge bg-info text-dark">@Html.DisplayFor(m => item.BloomLevel)</span></td>
                            <td>
                                @if (item.Status == asg1.DAL.Enums.QuestionStatus.Draft)
                                { <span class="badge bg-warning text-dark">Nháp</span> }
                                else if (item.Status == asg1.DAL.Enums.QuestionStatus.Approved)
                                { <span class="badge bg-success">Đã duyệt</span> }
                                else if (item.Status == asg1.DAL.Enums.QuestionStatus.Rejected)
                                { <span class="badge bg-danger">Từ chối</span> }
                                else
                                { <span class="badge bg-secondary">@Html.DisplayFor(m => item.Status)</span> }
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>@item.RubricCount</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.QuestionId" class="btn btn-outline-secondary" title="Chi tiết">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@item.QuestionId" class="btn btn-outline-primary" title="Sửa">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.QuestionId" class="btn btn-outline-danger" title="Xóa">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center mt-4">
    <ul class="pagination shadow-sm">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-subjectId="@Model.SubjectId" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword">&laquo; Trước</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">&laquo; Trước</a></li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-subjectId="@Model.SubjectId" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword">@i</a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-subjectId="@Model.SubjectId" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword">Sau &raquo;</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Sau &raquo;</a></li>
        }
    </ul>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const filterForm = document.getElementById('filterForm');
            const subjectSelect = document.getElementById('subjectSelect');
            const statusSelect = document.getElementById('statusSelect');
            let timeout = null;
            let currentAbortController = null;

            function loadData(url) {
                if (currentAbortController) {
                    currentAbortController.abort();
                }
                currentAbortController = new AbortController();

                // Add a subtle loading effect
                const cardBody = document.querySelector('.card-body');
                if (cardBody) cardBody.style.opacity = '0.6';

                fetch(url, { signal: currentAbortController.signal })
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        // Replace the table content
                        const newCardBody = doc.querySelector('.card-body');
                        if (newCardBody && cardBody) {
                            cardBody.innerHTML = newCardBody.innerHTML;
                        }
                        
                        // Replace the pagination content
                        const currentPaginationContainer = document.querySelector('.pagination')?.parentNode;
                        const newPaginationContainer = doc.querySelector('.pagination')?.parentNode;
                        if (currentPaginationContainer && newPaginationContainer) {
                            currentPaginationContainer.innerHTML = newPaginationContainer.innerHTML;
                        }
                        
                        if (cardBody) cardBody.style.opacity = '1';
                        
                        // Update URL without reloading page
                        window.history.replaceState({}, '', url);
                    })
                    .catch(err => {
                        if (err.name === 'AbortError') {
                            return; // Fetch aborted
                        }
                        console.error('Error fetching data:', err);
                        if (cardBody) cardBody.style.opacity = '1';
                    });
            }

            function performSearch() {
                const url = new URL(filterForm.action);
                const formData = new FormData(filterForm);
                const searchParams = new URLSearchParams();
                for (const pair of formData.entries()) {
                    if (pair[1]) searchParams.append(pair[0], pair[1]);
                }
                url.search = searchParams.toString();
                loadData(url.toString());
            }

            // Debounced search on input
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(timeout);
                    timeout = setTimeout(performSearch, 400); // 400ms debounce
                });
            }

            // Search on subject change or status change
            if (subjectSelect) subjectSelect.addEventListener('change', performSearch);
            if (statusSelect) statusSelect.addEventListener('change', performSearch);

            // Prevent form submit from reloading page
            if (filterForm) {
                filterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    performSearch();
                });
            }

            // AJAX for pagination links
            document.addEventListener('click', function (e) {
                const pageLink = e.target.closest('.page-link');
                if (pageLink && pageLink.href && !pageLink.href.endsWith('#')) {
                    e.preventDefault();
                    loadData(pageLink.href);
                }
            });
        });
    </script>
}
