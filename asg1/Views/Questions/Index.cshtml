@model IEnumerable<asg1.Models.Entities.Question>

@{
    ViewData["Title"] = "Questions";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0 text-primary"><i class="bi bi-question-circle"></i> Question Bank</h4>
        <div class="d-flex align-items-center gap-3">
            <form id="filterForm" asp-action="Index" method="get" class="d-flex gap-2 mb-0">
                <input type="text" name="searchString" class="form-control" placeholder="Search content..." value="@ViewBag.CurrentSearchString" id="searchInput" />
                <select id="subjectSelect" name="subjectId" class="form-select" asp-items="ViewBag.Subjects">
                    <option value="">-- All Subjects --</option>
                </select>
            </form>
            <a asp-action="Create" class="btn btn-primary text-nowrap"><i class="bi bi-plus-circle"></i> Create New</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="w-50">Content</th>
                        <th class="text-nowrap">Subject</th>
                        <th class="text-nowrap">Bloom Level</th>
                        <th class="text-nowrap">Status</th>
                        <th class="text-nowrap">Source</th>
                        <th class="text-nowrap">Created At</th>
                        <th class="text-center text-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No questions found matching your search.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;">
                                    @Html.Raw(item.Content)
                                </div>
                            </td>
                            <td><span class="badge bg-secondary">@item.Subject?.Name</span></td>
                            <td><span class="badge bg-info text-dark">@item.BloomLevel</span></td>
                            <td>
                                @if(item.Status == asg1.Models.Enums.QuestionStatus.Draft) { <span class="badge bg-warning text-dark">Draft</span> }
                                @if(item.Status == asg1.Models.Enums.QuestionStatus.Approved) { <span class="badge bg-success">Approved</span> }
                                @if(item.Status == asg1.Models.Enums.QuestionStatus.Rejected) { <span class="badge bg-danger">Rejected</span> }
                            </td>
                            <td>@item.Source</td>
                            <td>@item.CreatedAt.ToShortDateString()</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.QuestionId" class="btn btn-outline-primary" title="Edit">Edit</a>
                                    <a asp-action="Review" asp-route-id="@item.QuestionId" class="btn btn-outline-success" title="Review">Review</a>
                                    <a asp-action="Delete" asp-route-id="@item.QuestionId" class="btn btn-outline-danger" title="Delete">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center mt-4">
    <ul class="pagination shadow-sm">
        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-subjectId="@ViewBag.CurrentSubjectId" asp-route-searchString="@ViewBag.CurrentSearchString">&laquo; Prev</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">&laquo; Prev</a></li>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-subjectId="@ViewBag.CurrentSubjectId" asp-route-searchString="@ViewBag.CurrentSearchString">@i</a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-subjectId="@ViewBag.CurrentSubjectId" asp-route-searchString="@ViewBag.CurrentSearchString">Next &raquo;</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Next &raquo;</a></li>
        }
    </ul>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const filterForm = document.getElementById('filterForm');
            const subjectSelect = document.getElementById('subjectSelect');
            let timeout = null;
            let currentAbortController = null;

            function loadData(url) {
                if (currentAbortController) {
                    currentAbortController.abort();
                }
                currentAbortController = new AbortController();

                // Add a subtle loading effect
                const cardBody = document.querySelector('.card-body');
                if (cardBody) cardBody.style.opacity = '0.6';

                fetch(url, { signal: currentAbortController.signal })
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        // Replace the table content
                        const newCardBody = doc.querySelector('.card-body');
                        if (newCardBody && cardBody) {
                            cardBody.innerHTML = newCardBody.innerHTML;
                        }
                        
                        // Replace the pagination content
                        const currentPaginationContainer = document.querySelector('.pagination')?.parentNode;
                        const newPaginationContainer = doc.querySelector('.pagination')?.parentNode;
                        if (currentPaginationContainer && newPaginationContainer) {
                            currentPaginationContainer.innerHTML = newPaginationContainer.innerHTML;
                        }
                        
                        if (cardBody) cardBody.style.opacity = '1';
                        
                        // Update URL without reloading page
                        window.history.replaceState({}, '', url);
                    })
                    .catch(err => {
                        if (err.name === 'AbortError') {
                            return; // Fetch aborted
                        }
                        console.error('Error fetching data:', err);
                        if (cardBody) cardBody.style.opacity = '1';
                    });
            }

            function performSearch() {
                const url = new URL(filterForm.action);
                const formData = new FormData(filterForm);
                const searchParams = new URLSearchParams(formData);
                url.search = searchParams.toString();
                loadData(url.toString());
            }

            // Debounced search on input
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(timeout);
                    timeout = setTimeout(performSearch, 400); // 400ms debounce
                });
            }

            // Search on subject change
            if (subjectSelect) {
                subjectSelect.addEventListener('change', performSearch);
            }

            // Prevent form submit from reloading page
            if (filterForm) {
                filterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    performSearch();
                });
            }

            // AJAX for pagination links
            document.addEventListener('click', function (e) {
                const pageLink = e.target.closest('.page-link');
                if (pageLink && pageLink.href && !pageLink.href.endsWith('#')) {
                    e.preventDefault();
                    loadData(pageLink.href);
                }
            });
        });
    </script>
}
