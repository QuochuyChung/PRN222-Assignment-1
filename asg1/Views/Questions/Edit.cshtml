@model QuestionFormViewModel
@{
    ViewData["Title"] = "Sửa câu hỏi";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Sửa câu hỏi #@Model.QuestionId</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.QuestionId" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="QuestionId" />

                    <div class="mb-3">
                        <label asp-for="SubjectId" class="form-label fw-bold"></label>
                        <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-bold"></label>
                        <textarea asp-for="Content" class="form-control" rows="6" id="tinyMceContent"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BloomLevel" class="form-label fw-bold"></label>
                        <select asp-for="BloomLevel" asp-items="Html.GetEnumSelectList<BloomLevel>()" class="form-select"></select>
                        <span asp-validation-for="BloomLevel" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <input asp-for="Status" class="form-control" readonly />
                        <span class="form-text text-muted">Trạng thái và nguồn được giữ nguyên khi cập nhật.</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#tinyMceContent',
            plugins: 'lists code table',
            toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent',
            menubar: false,
            branding: false
        });
    </script>
}
